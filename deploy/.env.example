# Every configuration value, documented. ./run.sh copies this to .env and fills the secrets. Never commit .env.
# NAME=default   # what it controls, valid range/units

# --- Application ---
PORT=8080                        # host port for the API, bound to 127.0.0.1 only
BASE_URL=http://localhost:8080   # public base URL (set by the hosting platform when hosted)
DEMO_MODE=true                  # true for the local demo and the hosted copy (self-registration, email sign-in); false only to test the hardened path
# Optional settings that are usually empty keep their comment on the line above: Compose would read an
# inline comment after an empty value as the value.
# The path the site is served under behind a reverse proxy, e.g. /projects/ebay; empty serves it at /
PATH_BASE=
# Comma-separated proxy IPs whose X-Forwarded-For and X-Forwarded-Proto are believed; empty trusts none
TRUSTED_PROXIES=

# --- Demo seed (the migrator, deploy/compose.yaml) ---
SEED_DEMO=true                   # true adds the demo accounts and auctions once, to an empty database
ADMIN_PASSWORD=                  # REQUIRED when seeding: admin@auction.test; ./run.sh generates it
DEMO_PASSWORD=                   # REQUIRED when seeding: seller@auction.test and buyer@auction.test
SIMULATOR_PASSWORD=              # the 51 reserved simulator accounts (sim-seller, sim-001..050@auction.test); empty adds none
SIMULATOR_CONTROL_TOKEN=         # REQUIRED: the API's bearer token for the simulator's control endpoint (16+ characters); ./run.sh generates it
# Seeding never changes an existing account's password.

# --- PostgreSQL (deploy/compose.yaml) ---
POSTGRES_DB=auction              # database name
POSTGRES_USER=auction_admin      # superuser, used only by the bootstrap script on first start
POSTGRES_PASSWORD=               # REQUIRED: generate locally, never commit
MIGRATOR_DB_PASSWORD=            # REQUIRED: owns the schema; used only by the one-shot migrator
ENGINE_DB_PASSWORD=              # REQUIRED: the auction engine, the only writer of auction state
API_DB_PASSWORD=                 # REQUIRED: the API (reads, relay, notifications)
VERIFIER_DB_PASSWORD=            # REQUIRED: the read-only verifier
# The role passwords are set when the data volume is first created; to change one later, use ALTER ROLE.
POSTGRES_PORT=5432               # host port, bound to 127.0.0.1 only

# --- Auction engine (deploy/compose.yaml) ---
ENGINE_DB_POOL_SIZE=50           # engine connection pool, connections (1..)
ENGINE_LOCK_TIMEOUT=00:00:02     # how long a command waits for an auction lock before reporting busy (hh:mm:ss)
AUCTION_MIN_DURATION=00:01:00    # shortest allowed auction (hh:mm:ss); 1 minute for the demo
AUCTION_AMOUNT_CAP_CENTS=1000000000  # largest amount accepted anywhere, in cents (1..1000000000, the database's limit)
ENGINE_CLOSE_WORKER_ENABLED=true # true on exactly one running engine: starts and closes auctions on time, sweeps old keys
ENGINE_KEY_RETENTION=1.00:00:00  # how long a request's idempotency key is remembered (d.hh:mm:ss); 24 hours

# --- Demo reset (the demo-clock service; DEMO_MODE only) ---
DEMO_RESET_AT_UTC=09:00          # the daily reset to the seeded state (UTC, HH:mm); an admin can also reset from the Admin area

# --- Redis (deploy/compose.yaml) ---
REDIS_PORT=6379                  # host port, bound to 127.0.0.1 only

# --- Observability (optional; the "observability" profile in deploy/compose.yaml) ---
# Where the API and engine send OpenTelemetry traces, metrics and logs; empty sends nothing.
# With the profile on: http://aspire-dashboard:18889
OTEL_EXPORTER_OTLP_ENDPOINT=
DASHBOARD_PORT=18888             # host port for the Aspire dashboard UI, bound to 127.0.0.1 only
