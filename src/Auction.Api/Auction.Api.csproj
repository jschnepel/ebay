<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The public HTTP API: accounts and cookie sessions, auction reads straight from PostgreSQL (as the
    read-only api role), and every auction command forwarded to the engine over gRPC. It also serves the
    Blazor WebAssembly client, so the browser and the API share one origin.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The chiseled runtime image has no ICU; nothing here needs culture-specific behaviour. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Auction.Domain\Auction.Domain.csproj" />
    <!-- The browser client, served from this origin. -->
    <ProjectReference Include="..\Auction.Web\Auction.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Auction.Contracts\auction\v1\auction.proto" ProtoRoot="..\Auction.Contracts" GrpcServices="Client" Access="Internal" Link="Protos\auction.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.HealthCheck" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>

</Project>
