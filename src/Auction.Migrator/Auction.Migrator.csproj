<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One-shot migrator: applies the EF Core migrations as the schema-owning `migrator` role, optionally adds
    the demo seed, then exits.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- The chiseled runtime image has no ICU; nothing here needs culture-specific behaviour. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="StackExchange.Redis" />
    <!-- PasswordHasher for the seeded accounts, the same hash format the API verifies. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
  </ItemGroup>

</Project>
