@page "/"
@implements IAsyncDisposable
@inject AuctionApi Api
@inject LiveUpdates Live
@inject ViewRefresher Refresher

<PageTitle>Auctions</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Auctions</MudText>

<MudPaper Class="pa-3 mb-4" Outlined="true">
    <MudGrid Spacing="2" Justify="Justify.FlexStart" role="search">
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_query" Label="Search titles" Immediate="true" OnKeyDown="SearchOnEnterAsync"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="8" sm="4">
            <MudSelect T="string" @bind-Value="_status" Label="Show">
                <MudSelectItem T="string" Value="@("")">All</MudSelectItem>
                <MudSelectItem T="string" Value="@("active")">Active</MudSelectItem>
                <MudSelectItem T="string" Value="@("ending_soon")">Ending within the hour</MudSelectItem>
                <MudSelectItem T="string" Value="@("closed")">Closed</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="4" sm="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync" FullWidth="true">Search</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<PageState State="State" Error="@_list.Error" Retry="SearchAsync" LoadingText="Loading auctions…">
    <EmptyContent>
        @if (_searched)
        {
            <MudText>No auctions match. Try another word or show all.</MudText>
        }
        else
        {
            <MudText>No auctions are listed yet.</MudText>
            <MudButton Class="mt-2" Href="/sell/new" Variant="Variant.Outlined">List an item</MudButton>
        }
    </EmptyContent>
    <ChildContent>
        <MudGrid Spacing="3">
            @foreach (var auction in _list.Items!)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Outlined="true" Class="auction-card" data-testid="auction-row">
                        <a href="@($"/auctions/{auction.Id}")" class="auction-card-picture" tabindex="-1" aria-hidden="true">
                            @if (auction.CoverImageId is { } cover)
                            {
                                <img src="@($"api/v1/images/{cover}")" alt="" data-testid="cover" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Image" Size="Size.Large" />
                            }
                        </a>
                        <MudCardContent>
                            <MudLink Href="@($"/auctions/{auction.Id}")" Typo="Typo.subtitle1" Class="auction-card-title">@auction.Title</MudLink>
                            <MudText Typo="Typo.h6" data-testid="price">@Format.Price(auction)</MudText>
                            <MudText Typo="Typo.body2">
                                @auction.BidCount @(auction.BidCount == 1 ? "bid" : "bids") · @Format.Status(auction.Status)
                            </MudText>
                            <MudText Typo="Typo.caption">Ends @Format.Time(auction.EndsAt)</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
        @if (_list.NextCursor is not null)
        {
            <div class="d-flex justify-center mt-4">
                <MudButton Variant="Variant.Outlined" OnClick="_list.MoreAsync">Show more</MudButton>
            </div>
        }
    </ChildContent>
</PageState>

@code {
    private LiveList<AuctionSummary> _list = null!;
    private string _query = "";
    private string _status = "";
    private bool _searched;

    private ViewState State => _list switch
    {
        { Items: null, Error: not null } => ViewState.Error,
        { Items: null } => ViewState.Loading,
        { Items.Count: 0 } => ViewState.Empty,
        _ => ViewState.Content,
    };

    protected override async Task OnInitializedAsync()
    {
        _list = NewList();
        Live.Changed += OnChangedAsync;
        await _list.MoreAsync();
        await Live.WatchDirectoryAsync();
        await Refresher.StartAsync(RefreshAsync);
    }

    // Each search starts a fresh list; the filter it was made with stays with its pages.
    private LiveList<AuctionSummary> NewList()
    {
        var (query, status) = (_query, _status);
        return new LiveList<AuctionSummary>(cursor => Api.SearchAsync(query, status, cursor));
    }

    private async Task SearchAsync()
    {
        _searched = !string.IsNullOrWhiteSpace(_query) || !string.IsNullOrEmpty(_status);
        _list = NewList();
        await _list.MoreAsync();
    }

    private Task SearchOnEnterAsync(KeyboardEventArgs key) => key.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private Task OnChangedAsync(AuctionChanged hint) =>
        _list.Items?.Find(item => item.Id == hint.AuctionId) is { } shown && hint.Version > shown.Version ? RefreshAsync() : Task.CompletedTask;

    private async Task RefreshAsync()
    {
        await _list.ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Live.Changed -= OnChangedAsync;
        await Live.UnwatchDirectoryAsync();
        await Refresher.DisposeAsync();
    }
}
