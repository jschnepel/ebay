@page "/"
@inject AuctionApi Api

<PageTitle>Auctions</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Auctions</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_items is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading auctions" />
}
else if (_items.Count == 0)
{
    <MudText>No auctions are listed yet.</MudText>
}
else
{
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr><th>Item</th><th>Price</th><th>Bids</th><th>Status</th><th>Ends</th></tr>
        </thead>
        <tbody>
            @foreach (var auction in _items)
            {
                <tr data-testid="auction-row">
                    <td><MudLink Href="@($"/auctions/{auction.Id}")">@auction.Title</MudLink></td>
                    <td>@Format.Price(auction)</td>
                    <td>@auction.BidCount</td>
                    <td>@Format.Status(auction.Status)</td>
                    <td>@Format.Time(auction.EndsAt)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    @if (_next is not null)
    {
        <MudButton Class="mt-2" Variant="Variant.Outlined" OnClick="MoreAsync">Show more</MudButton>
    }
}

@code {
    private List<AuctionSummary>? _items;
    private string? _next;
    private string? _error;

    protected override Task OnInitializedAsync() => MoreAsync();

    private async Task MoreAsync()
    {
        var page = await Api.ListAsync(_next);
        if (!page.Succeeded)
        {
            _error = page.Message;
            return;
        }

        (_items ??= []).AddRange(page.Value!.Items);
        _next = page.Value.NextCursor;
    }
}
