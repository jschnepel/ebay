@page "/"
@implements IAsyncDisposable
@inject AuctionApi Api
@inject LiveUpdates Live
@inject ViewRefresher Refresher

<PageTitle>Auctions</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Auctions</MudText>

<div class="searchbar" role="search">
    <MudTextField @bind-Value="_query" Label="Search titles" Immediate="true" OnKeyDown="SearchOnEnterAsync"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    <MudSelect T="string" @bind-Value="_status" Label="Show">
        <MudSelectItem T="string" Value="@("active")">Live now</MudSelectItem>
        <MudSelectItem T="string" Value="@("ending_soon")">Ending within the hour</MudSelectItem>
        <MudSelectItem T="string" Value="@("closed")">Closed</MudSelectItem>
        <MudSelectItem T="string" Value="@("")">All auctions</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">Search</MudButton>
</div>

<PageState State="State" Error="@_list.Error" Retry="SearchAsync" LoadingText="Loading auctions…">
    <EmptyContent>
        @if (_searched)
        {
            <MudText>No auctions match. Try another word, or show everything.</MudText>
        }
        else
        {
            <MudText>Nothing is up for auction right now.</MudText>
            <div class="d-flex flex-wrap justify-center gap-2 mt-3">
                <MudButton Href="sell/new" Variant="Variant.Filled" Color="Color.Primary">List an item</MudButton>
                <MudButton OnClick="ShowEverythingAsync" Variant="Variant.Outlined">Show closed auctions</MudButton>
            </div>
        }
    </EmptyContent>
    <ChildContent>
        <div class="lots">
            @foreach (var auction in _list.Items!)
            {
                <article class="@($"lot{(auction.Status is "closed" or "cancelled" ? " is-ended" : "")}")" data-testid="auction-row">
                    <LotCover Auction="auction" />
                    <div class="lot-body">
                        <a href="@($"auctions/{auction.Id}")" class="lot-title" title="@auction.Title">@auction.Title</a>
                        <LotPrice Auction="auction" />
                        <div class="lot-foot">
                            <span>@Bids(auction.BidCount)</span>
                            <LotClock Auction="auction" />
                        </div>
                    </div>
                </article>
            }
        </div>
        @if (_list.NextCursor is not null)
        {
            <div class="d-flex justify-center mt-6">
                <MudButton Variant="Variant.Outlined" OnClick="_list.MoreAsync">Show more</MudButton>
            </div>
        }
    </ChildContent>
</PageState>

@code {
    private LiveList<AuctionSummary> _list = null!;
    private string _query = "";
    // Live auctions first: a buyer lands on what can still be bid on; closed ones are one choice away.
    private string _status = "active";
    private bool _searched;

    private ViewState State => _list switch
    {
        { Items: null, Error: not null } => ViewState.Error,
        { Items: null } => ViewState.Loading,
        { Items.Count: 0 } => ViewState.Empty,
        _ => ViewState.Content,
    };

    protected override async Task OnInitializedAsync()
    {
        _list = NewList();
        Live.Changed += OnChangedAsync;
        await _list.MoreAsync();
        await Live.WatchDirectoryAsync();
        await Refresher.StartAsync(RefreshAsync);
    }

    // Each search starts a fresh list; the filter it was made with stays with its pages.
    private LiveList<AuctionSummary> NewList()
    {
        var (query, status) = (_query, _status);
        return new LiveList<AuctionSummary>(cursor => Api.SearchAsync(query, status, cursor));
    }

    private async Task SearchAsync()
    {
        _searched = !string.IsNullOrWhiteSpace(_query) || _status != "active";
        _list = NewList();
        await _list.MoreAsync();
    }

    private Task ShowEverythingAsync()
    {
        _status = "";
        return SearchAsync();
    }

    private static string Bids(long count) => count switch
    {
        0 => "No bids yet",
        1 => "1 bid",
        _ => $"{count} bids",
    };

    private Task SearchOnEnterAsync(KeyboardEventArgs key) => key.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private Task OnChangedAsync(AuctionChanged hint) =>
        _list.Items?.Find(item => item.Id == hint.AuctionId) is { } shown && hint.Version > shown.Version ? RefreshAsync() : Task.CompletedTask;

    private async Task RefreshAsync()
    {
        await _list.ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Live.Changed -= OnChangedAsync;
        await Live.UnwatchDirectoryAsync();
        await Refresher.DisposeAsync();
    }
}
