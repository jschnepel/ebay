@page "/"
@implements IAsyncDisposable
@inject AuctionApi Api
@inject LiveUpdates Live
@inject ViewRefresher Refresher

<PageTitle>Auctions</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Auctions</MudText>

@if (_list.Error is not null && _list.Items is null)
{
    <MudAlert Severity="Severity.Error">@_list.Error</MudAlert>
}
else if (_list.Items is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading auctions" />
}
else if (_list.Items.Count == 0)
{
    <MudText>No auctions are listed yet.</MudText>
}
else
{
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr><th><span class="sr-only">Picture</span></th><th>Item</th><th>Price</th><th>Bids</th><th>Status</th><th>Ends</th></tr>
        </thead>
        <tbody>
            @foreach (var auction in _list.Items)
            {
                <tr data-testid="auction-row">
                    <td>
                        @if (auction.CoverImageId is { } cover)
                        {
                            <img src="@($"api/v1/images/{cover}")" alt="" width="48" height="48" style="object-fit: cover" data-testid="cover" />
                        }
                    </td>
                    <td><MudLink Href="@($"/auctions/{auction.Id}")">@auction.Title</MudLink></td>
                    <td data-testid="price">@Format.Price(auction)</td>
                    <td>@auction.BidCount</td>
                    <td>@Format.Status(auction.Status)</td>
                    <td>@Format.Time(auction.EndsAt)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    @if (_list.NextCursor is not null)
    {
        <MudButton Class="mt-2" Variant="Variant.Outlined" OnClick="_list.MoreAsync">Show more</MudButton>
    }
}

@code {
    private LiveList<AuctionSummary> _list = null!;

    protected override async Task OnInitializedAsync()
    {
        _list = new LiveList<AuctionSummary>(Api.ListAsync);
        Live.Changed += OnChangedAsync;
        await _list.MoreAsync();
        await Live.WatchDirectoryAsync();
        await Refresher.StartAsync(RefreshAsync);
    }

    private Task OnChangedAsync(AuctionChanged hint) =>
        _list.Items?.Find(item => item.Id == hint.AuctionId) is { } shown && hint.Version > shown.Version ? RefreshAsync() : Task.CompletedTask;

    private async Task RefreshAsync()
    {
        await _list.ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Live.Changed -= OnChangedAsync;
        await Live.UnwatchDirectoryAsync();
        await Refresher.DisposeAsync();
    }
}
