@page "/auctions/{Id:guid}"
@implements IAsyncDisposable
@inject AuctionApi Api
@inject Session Session
@inject LiveUpdates Live
@inject ViewRefresher Refresher

<PageTitle>@(_auction?.Title ?? "Auction")</PageTitle>

@if (_error is not null || _auction is null)
{
    <MudText Typo="Typo.h4" HtmlTag="h1">Auction</MudText>
    <PageState State="@(_error is null ? ViewState.Loading : ViewState.Error)" Error="@_error" Retry="RefreshAsync" LoadingText="Loading the auction…" />
}
else
{
    var auction = _auction;
    <div class="lot-page">
        <div>
            <MudText Typo="Typo.h4" HtmlTag="h1">@auction.Title</MudText>
            @if (auction.ImageIds.Count > 0)
            {
                <div class="gallery">
                    @for (var i = 0; i < auction.ImageIds.Count; i++)
                    {
                        <img src="@($"api/v1/images/{auction.ImageIds[i]}")" alt="@($"{auction.Title}, picture {i + 1}")" data-testid="auction-image" />
                    }
                </div>
            }
            else
            {
                <LotCover Auction="auction" />
            }
            <p class="lot-description">@auction.Description</p>

            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Details</MudText>
            <dl class="facts">
                <dt>Bidding</dt>
                <dd>@(auction.BidEntry == "proxy" ? "Proxy: enter your maximum and the system bids for you, one step at a time" : $"Fixed steps of {Format.Dollars(auction.IncrementCents)}")</dd>
                <dt>Opening price</dt>
                <dd class="num">@Format.Dollars(auction.OpeningPriceCents)</dd>
                @if (auction.ReserveCents is { } reserve)
                {
                    <dt>Your reserve</dt>
                    <dd class="num">@Format.Dollars(reserve)</dd>
                }
                <dt>Starts</dt>
                <dd class="num">@Format.Time(auction.StartsAt)</dd>
                <dt>Ends</dt>
                <dd class="num">@Format.Time(auction.EndsAt)</dd>
            </dl>

            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Bid history</MudText>
            @if (_bids is null || _bids.Count == 0)
            {
                <MudText Class="muted">No bids yet.</MudText>
            }
            else
            {
                <div class="table-scroll">
                <MudSimpleTable Dense="true">
                    <thead><tr><th>Bidder</th><th>Amount</th><th>How</th><th>When</th></tr></thead>
                    <tbody>
                        @foreach (var bid in _bids)
                        {
                            <tr>
                                <td>@bid.Bidder</td>
                                <td class="num">@if (bid.AmountCents is { } cents)
                                    {@Format.Dollars(cents)}
                                    else
                                    {<span class="muted" title="A bid beaten at once keeps its amount private.">private</span>}</td>
                                <td>@Format.How(bid.Source, bid.AmountCents)</td>
                                <td class="num">@Format.Time(bid.AcceptedAt)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                </div>
            }
        </div>

        <aside class="ticket" aria-label="Bidding">
            <div>
                <div class="price-label">@PriceLabel(auction)</div>
                <LotPrice Auction="auction" TestId="current-price" />
            </div>
            @if (auction.Status == "active")
            {
                <span class="meter is-thick" aria-hidden="true"><span style="@($"width: {Clock.Elapsed(auction, DateTimeOffset.UtcNow) * 100:0.#}%")"></span></span>
            }
            <div class="ticket-row">
                <LotClock Auction="auction" />
                <span class="muted"><span data-testid="bid-count">@auction.BidCount</span> @(auction.BidCount == 1 ? "bid" : "bids")</span>
            </div>
            <dl class="ticket-facts">
                <dt>Status</dt>
                <dd data-testid="status">@Format.Status(auction.Status)@(auction.Outcome is { } outcome ? $" ({outcome.Replace('_', ' ')})" : "")</dd>
                @if (auction.ReserveMet is { } met)
                {
                    <dt>Reserve</dt>
                    <dd class="@(met ? "leading" : "")">@(met ? "Met" : "Not met yet")</dd>
                }
            </dl>

            @if (auction.YouLead)
            {
                <MudAlert Severity="Severity.Success" Dense="true">You are the highest bidder.</MudAlert>
            }

            @if (auction.Status == "active" && !auction.YouAreSeller)
            {
                @if (Session.Account is null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"sign-in?returnUrl=/auctions/{Id}")">Sign in to bid</MudButton>
                }
                else if (!Session.Account.IsAdmin)
                {
                    var button = GetBidButton();
                    <div>
                        <MudTextField @bind-Value="_amount" Label="@(auction.BidEntry == "proxy" ? "Your maximum ($)" : "Your bid ($)")" Immediate="true" ReadOnly="_busy"
                                      Variant="Variant.Outlined" InputMode="@(InputMode.@decimal)" OnKeyDown="BidOnEnterAsync"
                                      HelperText="@($"At least {Format.Dollars(auction.MinimumNextBidCents)}")" />
                        <MudButton Class="mt-2 bid-submit" Variant="Variant.Filled" Color="button.Color" FullWidth="true" Size="Size.Large" OnClick="BidAsync"
                                   Disabled="button.Disabled" data-testid="bid-submit">@button.Label</MudButton>
                        <span class="sr-only" role="status">@(_busy ? button.Label : "")</span>
                    </div>
                }
            }
            else if (auction.YouAreSeller)
            {
                <MudText Typo="Typo.body2" Class="muted">This is your listing.</MudText>
            }
            @if (_receipt is { } receipt && receipt.BidderId == Session.Account?.Id)
            {
                <MudAlert Class="mb-4" Severity="@(receipt.Reason is null ? Severity.Success : Severity.Error)" data-testid="bid-result">
                    <div>
                        <strong>@(receipt.Reason is null ? "Accepted" : "Rejected")</strong>
                        · @Format.Dollars(receipt.AmountCents) · @receipt.Item · @(receipt.ReceivedOnly ? "Received " : "")
                        <time datetime="@receipt.Timestamp.ToString("O", CultureInfo.InvariantCulture)">@receipt.Timestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.InvariantCulture)</time>
                    </div>
                    @if (receipt.Reason is { } reason)
                    {
                        <div data-testid="bid-reason">@reason</div>
                    }
                </MudAlert>
            }
            else if (_bidMessage is not null && Session.Account is { IsAdmin: false })
            {
                <MudAlert Class="mb-4" Severity="Severity.Warning" data-testid="bid-result">@_bidMessage</MudAlert>
            }
        </aside>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private AuctionDetail? _auction;
    private List<BidView>? _bids;
    private string? _error;
    private string _amount = "";
    private string? _bidMessage;
    private BidReceipt? _receipt;
    private bool _busy;

    private sealed record BidReceipt(Guid BidderId, long AmountCents, string Item, DateTimeOffset Timestamp, bool ReceivedOnly, string? Reason);

    private (Guid BidderId, long AmountCents, string Key)? _pending;

    private Guid? _watching;
    private bool _started;

    protected override async Task OnParametersSetAsync()
    {
        await Session.LoadAsync();
        if (_watching != Id)
        {
            _pending = null;
            _amount = "";
            _bidMessage = null;
            _receipt = null;
            _busy = false;
            if (_watching is { } previous)
            {
                await Live.UnwatchAsync(previous);
            }

            (_auction, _bids, _error, _watching) = (null, null, null, Id);
            await Live.WatchAsync(Id);
        }

        await LoadAsync();
        if (!_started)
        {
            _started = true;
            Live.Changed += OnChangedAsync;
            await Refresher.StartAsync(RefreshAsync);
        }
    }

    private Task OnChangedAsync(AuctionChanged hint) =>
        hint.AuctionId == Id && hint.Version > (_auction?.Version ?? -1) ? RefreshAsync() : Task.CompletedTask;

    private async Task RefreshAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Answers may come back out of order (hint, timer, reconnect); an older version never replaces a newer one.
    private async Task LoadAsync()
    {
        var id = Id;
        var detail = await Api.DetailAsync(id);
        if (id != Id)
        {
            return;
        }

        if (!detail.Succeeded)
        {
            _error = detail.Problem!.Status == 404 ? "This auction doesn't exist or isn't visible to you." : detail.Message;
            return;
        }

        _error = null;
        var shown = _auction;
        _auction = VersionGate.Newest(shown, detail.Value!);
        if (!ReferenceEquals(_auction, detail.Value))
        {
            return;
        }

        var bids = await Api.BidsAsync(id);
        if (bids.Succeeded && id == Id && _auction.Version == detail.Value!.Version)
        {
            _bids = bids.Value!.Items.ToList();
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.Changed -= OnChangedAsync;
        if (_watching is { } id)
        {
            await Live.UnwatchAsync(id);
        }

        await Refresher.DisposeAsync();
    }

    private (string Label, Color Color, bool Disabled) GetBidButton()
    {
        var bidderId = Session.Account?.Id;
        var entered = Format.ParseDollars(_amount);
        if (_pending is { } pending && pending.BidderId == bidderId)
        {
            if (_busy)
            {
                return ($"Submitting {Format.Dollars(pending.AmountCents)}…", Color.Warning, true);
            }

            if (entered == pending.AmountCents)
            {
                return ($"Unconfirmed · retry {Format.Dollars(pending.AmountCents)}", Color.Warning, false);
            }
        }

        if (_receipt is { } receipt && receipt.BidderId == bidderId)
        {
            if (receipt.Reason is null && string.IsNullOrEmpty(_amount))
            {
                return ("Accepted", Color.Success, true);
            }

            if (receipt.Reason is not null && entered == receipt.AmountCents)
            {
                return ("Rejected · place bid again", Color.Error, false);
            }
        }

        return ("Place bid", Color.Primary, false);
    }

    private static string PriceLabel(AuctionDetail auction) => (auction.Status, auction.CurrentPriceCents) switch
    {
        ("closed", not null) => "Final price",
        (_, null) => "Opening price",
        _ => "Current price",
    };

    private Task BidOnEnterAsync(KeyboardEventArgs key) => key.Key == "Enter" && !GetBidButton().Disabled ? BidAsync() : Task.CompletedTask;

    private async Task BidAsync()
    {
        if (_busy || Session.Account is not { IsAdmin: false } bidder || _auction is not { } auction || auction.Id != Id)
        {
            return;
        }

        _receipt = null;
        _bidMessage = null;
        if (Format.ParseDollars(_amount) is not { } cents)
        {
            _bidMessage = "Enter an amount in dollars, like 12.50.";
            return;
        }

        if (_pending is not { } pending || pending.BidderId != bidder.Id || pending.AmountCents != cents)
        {
            pending = (bidder.Id, cents, Guid.NewGuid().ToString());
            _pending = pending;
        }

        _busy = true;
        ApiResult<CommandResponse> result;
        try
        {
            result = await Api.BidAsync(Id, cents, pending.Key);
        }
        finally
        {
            if (_pending == pending)
            {
                _busy = false;
            }
        }

        if (_pending != pending)
        {
            return;
        }

        if (Session.Account?.Id != bidder.Id)
        {
            _pending = null;
            return;
        }

        var problem = result.Problem;
        if (problem is not null && (problem.Status is < 400 or >= 500 or 408 or 429))
        {
            // A gateway or network failure can arrive after the engine has committed the bid.
            _bidMessage = problem.Status == 0 ? result.Message : Problem.UnconfirmedBid.Title;
            return;
        }

        _pending = null;
        var decidedAt = result.Value?.DecidedAt ?? problem?.DecidedAt;
        _receipt = new BidReceipt(bidder.Id, cents, auction.Title, decidedAt ?? DateTimeOffset.UtcNow,
            ReceivedOnly: decidedAt is null, Reason: problem is null ? null : result.Message);
        if (result.Succeeded)
        {
            _amount = "";
            StateHasChanged();
            await LoadAsync();
        }
    }
}
