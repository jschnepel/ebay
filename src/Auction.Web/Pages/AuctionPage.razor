@page "/auctions/{Id:guid}"
@implements IAsyncDisposable
@inject AuctionApi Api
@inject Session Session
@inject LiveUpdates Live
@inject ViewRefresher Refresher

<PageTitle>@(_auction?.Title ?? "Auction")</PageTitle>

@if (_error is not null || _auction is null)
{
    <MudText Typo="Typo.h4" HtmlTag="h1">Auction</MudText>
    <PageState State="@(_error is null ? ViewState.Loading : ViewState.Error)" Error="@_error" Retry="RefreshAsync" LoadingText="Loading the auction…" />
}
else
{
    var auction = _auction;
    <div class="lot-page">
        <div>
            <MudText Typo="Typo.h4" HtmlTag="h1">@auction.Title</MudText>
            @if (auction.ImageIds.Count > 0)
            {
                <div class="gallery">
                    @for (var i = 0; i < auction.ImageIds.Count; i++)
                    {
                        <img src="@($"api/v1/images/{auction.ImageIds[i]}")" alt="@($"{auction.Title}, picture {i + 1}")" data-testid="auction-image" />
                    }
                </div>
            }
            else
            {
                <LotCover Auction="auction" />
            }
            <p class="lot-description">@auction.Description</p>

            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Details</MudText>
            <dl class="facts">
                <dt>Bidding</dt>
                <dd>@(auction.BidEntry == "proxy" ? "Proxy: enter your maximum and the system bids for you, one step at a time" : $"Fixed steps of {Format.Dollars(auction.IncrementCents)}")</dd>
                <dt>Opening price</dt>
                <dd class="num">@Format.Dollars(auction.OpeningPriceCents)</dd>
                @if (auction.ReserveCents is { } reserve)
                {
                    <dt>Your reserve</dt>
                    <dd class="num">@Format.Dollars(reserve)</dd>
                }
                <dt>Starts</dt>
                <dd class="num">@Format.Time(auction.StartsAt)</dd>
                <dt>Ends</dt>
                <dd class="num">@Format.Time(auction.EndsAt)</dd>
            </dl>

            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Bid history</MudText>
            @if (_bids is null || _bids.Count == 0)
            {
                <MudText Class="muted">No bids yet.</MudText>
            }
            else
            {
                <div class="table-scroll">
                <MudSimpleTable Dense="true">
                    <thead><tr><th>Bidder</th><th>Amount</th><th>How</th><th>When</th></tr></thead>
                    <tbody>
                        @foreach (var bid in _bids)
                        {
                            <tr>
                                <td>@bid.Bidder</td>
                                <td class="num">@if (bid.AmountCents is { } cents)
                                    {@Format.Dollars(cents)}
                                    else
                                    {<span class="muted" title="A bid beaten at once keeps its amount private.">private</span>}</td>
                                <td>@Format.How(bid.Source, bid.AmountCents)</td>
                                <td class="num">@Format.Time(bid.AcceptedAt)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                </div>
            }
        </div>

        <aside class="ticket" aria-label="Bidding">
            <div>
                <div class="price-label">@PriceLabel(auction)</div>
                <LotPrice Auction="auction" TestId="current-price" />
            </div>
            @if (auction.Status == "active")
            {
                <span class="meter is-thick" aria-hidden="true"><span style="@($"width: {Clock.Elapsed(auction, DateTimeOffset.UtcNow) * 100:0.#}%")"></span></span>
            }
            <div class="ticket-row">
                <LotClock Auction="auction" />
                <span class="muted">@(auction.BidCount == 1 ? "1 bid" : $"{auction.BidCount} bids")</span>
            </div>
            <dl class="ticket-facts">
                <dt>Status</dt>
                <dd data-testid="status">@Format.Status(auction.Status)@(auction.Outcome is { } outcome ? $" ({outcome.Replace('_', ' ')})" : "")</dd>
                @if (auction.ReserveMet is { } met)
                {
                    <dt>Reserve</dt>
                    <dd class="@(met ? "leading" : "")">@(met ? "Met" : "Not met yet")</dd>
                }
            </dl>

            @if (auction.YouLead)
            {
                <MudAlert Severity="Severity.Success" Dense="true">You are the highest bidder.</MudAlert>
            }

            @if (auction.Status == "active" && !auction.YouAreSeller)
            {
                @if (Session.Account is null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"sign-in?returnUrl=/auctions/{Id}")">Sign in to bid</MudButton>
                }
                else if (!Session.Account.IsAdmin)
                {
                    <div>
                        <MudTextField @bind-Value="_amount" Label="@(auction.BidEntry == "proxy" ? "Your maximum ($)" : "Your bid ($)")" Immediate="true"
                                      Variant="Variant.Outlined" InputMode="@(InputMode.@decimal)" OnKeyDown="BidOnEnterAsync"
                                      HelperText="@($"At least {Format.Dollars(auction.MinimumNextBidCents)}")" />
                        <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" OnClick="BidAsync" Disabled="_busy">Place bid</MudButton>
                        @if (_bidMessage is not null)
                        {
                            <MudAlert Class="mt-2" Dense="true" Severity="@(_bidAccepted ? Severity.Success : Severity.Error)" data-testid="bid-result">@_bidMessage</MudAlert>
                        }
                    </div>
                }
            }
            else if (auction.YouAreSeller)
            {
                <MudText Typo="Typo.body2" Class="muted">This is your listing.</MudText>
            }
        </aside>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private AuctionDetail? _auction;
    private List<BidView>? _bids;
    private string? _error;
    private string _amount = "";
    private string? _bidMessage;
    private bool _bidAccepted;
    private bool _busy;

    // One key per intended bid: a retry of the same amount reuses it, so it can't be placed twice.
    private (string Amount, string Key)? _pending;

    private Guid? _watching;
    private bool _started;

    protected override async Task OnParametersSetAsync()
    {
        await Session.LoadAsync();
        if (_watching != Id)
        {
            if (_watching is { } previous)
            {
                await Live.UnwatchAsync(previous);
            }

            (_auction, _bids, _error, _watching) = (null, null, null, Id);
            await Live.WatchAsync(Id);
        }

        await LoadAsync();
        if (!_started)
        {
            _started = true;
            Live.Changed += OnChangedAsync;
            await Refresher.StartAsync(RefreshAsync);
        }
    }

    private Task OnChangedAsync(AuctionChanged hint) =>
        hint.AuctionId == Id && hint.Version > (_auction?.Version ?? -1) ? RefreshAsync() : Task.CompletedTask;

    private async Task RefreshAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    // Answers may come back out of order (hint, timer, reconnect); an older version never replaces a newer one.
    private async Task LoadAsync()
    {
        var id = Id;
        var detail = await Api.DetailAsync(id);
        if (id != Id)
        {
            return;
        }

        if (!detail.Succeeded)
        {
            _error = detail.Problem!.Status == 404 ? "This auction doesn't exist or isn't visible to you." : detail.Message;
            return;
        }

        _error = null;
        var shown = _auction;
        _auction = VersionGate.Newest(shown, detail.Value!);
        if (!ReferenceEquals(_auction, detail.Value))
        {
            return;
        }

        var bids = await Api.BidsAsync(id);
        if (bids.Succeeded && id == Id && _auction.Version == detail.Value!.Version)
        {
            _bids = bids.Value!.Items.ToList();
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.Changed -= OnChangedAsync;
        if (_watching is { } id)
        {
            await Live.UnwatchAsync(id);
        }

        await Refresher.DisposeAsync();
    }

    private static string PriceLabel(AuctionDetail auction) => (auction.Status, auction.CurrentPriceCents) switch
    {
        ("closed", not null) => "Final price",
        (_, null) => "Opening price",
        _ => "Current price",
    };

    private Task BidOnEnterAsync(KeyboardEventArgs key) => key.Key == "Enter" && !_busy ? BidAsync() : Task.CompletedTask;

    private async Task BidAsync()
    {
        if (Format.ParseDollars(_amount) is not { } cents)
        {
            (_bidAccepted, _bidMessage) = (false, "Enter an amount in dollars, like 12.50.");
            return;
        }

        if (_pending is not { } pending || pending.Amount != _amount)
        {
            pending = (_amount, Guid.NewGuid().ToString());
            _pending = pending;
        }

        _busy = true;
        var result = await Api.BidAsync(Id, cents, pending.Key);
        _busy = false;
        if (result.Succeeded)
        {
            _pending = null;
            _amount = "";
            (_bidAccepted, _bidMessage) = (true, result.Value!.YouLead == true ? "Bid placed. You are the highest bidder." : "Bid placed, but another bidder's maximum is higher.");
            await LoadAsync();
        }
        else
        {
            // A refusal is final for this key; only "busy" or no connection is worth retrying with it.
            if (result.Problem!.Status is not (0 or 503))
            {
                _pending = null;
            }

            (_bidAccepted, _bidMessage) = (false, result.Message);
        }
    }
}
