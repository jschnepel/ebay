@page "/sign-in"
@page "/login"
@inject AuctionApi Api
@inject Session Session
@inject NavigationManager Navigation

<PageTitle>@(_creating ? "Create an account" : "Sign in")</PageTitle>

<section class="panel auth-panel" aria-labelledby="auth-heading">
    @if (_creating)
    {
        <h1 id="auth-heading" class="auth-title">Create an account</h1>
        <p class="muted auth-lede">A display name and an email are enough in the demo. You’ll be signed in straight away.</p>
        <MudTextField @bind-Value="_displayName" Label="Display name" Immediate="true" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_signUpEmail" Label="Email for the new account" InputType="InputType.Email" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />

        <fieldset class="role-choice">
            <legend>Account type</legend>
            <MudRadioGroup @bind-Value="_role">
                <div class="role-option">
                    <MudRadio Value="@("user")" Color="Color.Primary">User</MudRadio>
                    <span class="muted">Browse, bid and sell.</span>
                </div>
                <div class="role-option">
                    <MudRadio Value="@("admin")" Color="Color.Primary">Admin</MudRadio>
                    <span class="muted">Run the site: live activity, moderation, users and the simulator. Admins don’t bid or sell.</span>
                </div>
            </MudRadioGroup>
        </fieldset>

        <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SignUpAsync" Disabled="_busy">Create account</MudButton>
        <p class="auth-switch">Already have an account? <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ShowSignIn">Sign in instead</MudButton></p>
    }
    else
    {
        <h1 id="auth-heading" class="auth-title">Sign in</h1>
        <p class="muted auth-lede">Enter the email of an account you created. There's no password in the demo.</p>
        <MudTextField @bind-Value="_signInEmail" Label="Email" InputType="InputType.Email" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SignInAsync" Disabled="_busy">Sign in</MudButton>
        <div class="auth-switch">
            <span class="muted">New here?</span>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ShowCreate">Create account</MudButton>
        </div>
    }

    @if (_error is not null)
    {
        <MudAlert Class="mt-4" Severity="Severity.Error" data-testid="sign-in-error">@_error</MudAlert>
    }

    @if (_existingEmail is not null)
    {
        @* A retried sign-up whose first attempt succeeded lands here: the account exists, so offer to use it. *@
        <MudButton Class="mt-2" Variant="Variant.Outlined" OnClick="SignInExistingAsync" Disabled="_busy">Sign in as @_existingEmail</MudButton>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool _creating;
    private string _displayName = "";
    private string _signUpEmail = "";
    private string _role = "user";
    private string _signInEmail = "";
    private string? _error;
    private bool _busy;

    private string? _existingEmail;

    private void ShowCreate() => (_creating, _error, _existingEmail) = (true, null, null);

    private void ShowSignIn() => (_creating, _error, _existingEmail) = (false, null, null);

    private async Task SignUpAsync()
    {
        var email = _signUpEmail.Trim();
        await RunAsync(() => Api.SignUpAsync(_displayName, email, _role));
        if (_error is not null && _lastProblem?.Code == "email_taken")
        {
            _existingEmail = email;
        }
    }

    // The page signs in by email alone; the built-in accounts' passwords are for the API (the simulator uses them).
    private Task SignInAsync()
    {
        if (string.IsNullOrWhiteSpace(_signInEmail))
        {
            (_error, _existingEmail) = ("Enter the email of an account you created.", null);
            return Task.CompletedTask;
        }

        return RunAsync(() => Api.SignInAsync(_signInEmail, null));
    }

    private Task SignInExistingAsync()
    {
        var email = _existingEmail!;
        return RunAsync(() => Api.SignInAsync(email, null));
    }

    private Problem? _lastProblem;

    private async Task RunAsync(Func<Task<ApiResult<Account>>> call)
    {
        _busy = true;
        (_error, _existingEmail) = (null, null);
        var result = await call();
        _busy = false;
        _lastProblem = result.Problem;
        if (!result.Succeeded)
        {
            // The API words this for password sign-in; with no password box, the only cause left is the email.
            _error = result.Problem?.Code == "sign_in_failed"
                ? "No account uses that email. Accounts you create are removed at the daily reset, so you may need to create it again."
                : result.Message;
            return;
        }

        var account = result.Value!;
        Session.SignedIn(account);
        // Admins have only the admin area. Return addresses are paths within the app; they resolve against
        // the page's base, so the app works under a path base.
        var next = IsLocalPath(ReturnUrl) ? ReturnUrl!.TrimStart('/') : "./";
        Navigation.NavigateTo(account.IsAdmin ? "admin" : next);
    }

    // Only a path on this site: "//host" and "/\host" would leave it.
    private static bool IsLocalPath(string? url) =>
        url is { Length: > 0 } && url[0] == '/' && (url.Length == 1 || (url[1] != '/' && url[1] != '\\'));
}
