@page "/my-bids"
@inject AuctionApi Api
@inject Session Session

<PageTitle>My bids</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">My bids</MudText>

@if (_signedOut)
{
    <MudText><MudLink Href="/sign-in?returnUrl=/my-bids">Sign in</MudLink> to see your bids.</MudText>
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_items is null)
{
    <MudProgressCircular Indeterminate="true" aria-label="Loading your bids" />
}
else if (_items.Count == 0)
{
    <MudText>You haven't bid on anything yet. <MudLink Href="/">Browse the auctions</MudLink>.</MudText>
}
else
{
    <MudSimpleTable Dense="true">
        <thead><tr><th>Item</th><th>Price</th><th>You</th><th>Status</th><th>Ends</th></tr></thead>
        <tbody>
            @foreach (var auction in _items)
            {
                <tr data-testid="my-bid-row">
                    <td><MudLink Href="@($"/auctions/{auction.Id}")">@auction.Title</MudLink></td>
                    <td>@Format.Price(auction)</td>
                    <td>@(auction.YouLead ? "Leading" : "Outbid")</td>
                    <td>@Format.Status(auction.Status)</td>
                    <td>@Format.Time(auction.EndsAt)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    @if (_next is not null)
    {
        <MudButton Class="mt-2" Variant="Variant.Outlined" OnClick="MoreAsync">Show more</MudButton>
    }
}

@code {
    private List<BiddingSummary>? _items;
    private string? _next;
    private string? _error;
    private bool _signedOut;

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        _signedOut = Session.Account is null;
        if (!_signedOut)
        {
            await MoreAsync();
        }
    }

    private async Task MoreAsync()
    {
        var page = await Api.MyBidsAsync(_next);
        if (!page.Succeeded)
        {
            _error = page.Message;
            return;
        }

        (_items ??= []).AddRange(page.Value!.Items);
        _next = page.Value.NextCursor;
    }
}
