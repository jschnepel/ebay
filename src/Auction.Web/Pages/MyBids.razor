@page "/my-bids"
@implements IAsyncDisposable
@inject AuctionApi Api
@inject Session Session
@inject LiveUpdates Live
@inject ViewRefresher Refresher

<PageTitle>My bids</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">My bids</MudText>

@if (_signedOut)
{
    <PageState State="ViewState.Forbidden" ForbiddenText="Sign in to see your bids." SignInReturn="/my-bids" />
}
else if (_list.Error is not null && _list.Items is null)
{
    <PageState State="ViewState.Error" Error="@_list.Error" Retry="RefreshAsync" />
}
else if (_list.Items is null)
{
    <PageState State="ViewState.Loading" LoadingText="Loading your bids…" />
}
else if (_list.Items.Count == 0)
{
    <div class="empty">
        <p class="empty-title">No bids yet</p>
        <p class="muted">Auctions you bid on appear here, with whether you're winning.</p>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="./">Browse the auctions</MudButton>
    </div>
}
else
{
    <div class="table-scroll">
    <MudSimpleTable Dense="true">
        <thead><tr><th>Item</th><th>Price</th><th>You</th><th>Status</th><th>Ends</th></tr></thead>
        <tbody>
            @foreach (var auction in _list.Items)
            {
                <tr data-testid="my-bid-row">
                    <td><MudLink Href="@($"auctions/{auction.Id}")">@auction.Title</MudLink></td>
                    <td>@Format.Price(auction)</td>
                    <td>@(auction.YouLead ? "Leading" : "Outbid")</td>
                    <td>@Format.Status(auction.Status)</td>
                    <td>@Format.Time(auction.EndsAt)</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    </div>
    @if (_list.NextCursor is not null)
    {
        <MudButton Class="mt-2" Variant="Variant.Outlined" OnClick="_list.MoreAsync">Show more</MudButton>
    }
}

@code {
    private LiveList<BiddingSummary> _list = null!;
    private bool _signedOut;

    protected override async Task OnInitializedAsync()
    {
        _list = new LiveList<BiddingSummary>(Api.MyBidsAsync);
        await Session.LoadAsync();
        _signedOut = Session.Account is null;
        if (_signedOut)
        {
            return;
        }

        Live.Changed += OnChangedAsync;
        await _list.MoreAsync();
        await Live.WatchDirectoryAsync();
        await Refresher.StartAsync(RefreshAsync);
    }

    private Task OnChangedAsync(AuctionChanged hint) =>
        _list.Items?.Find(item => item.Id == hint.AuctionId) is { } shown && hint.Version > shown.Version ? RefreshAsync() : Task.CompletedTask;

    private async Task RefreshAsync()
    {
        await _list.ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Live.Changed -= OnChangedAsync;
        if (!_signedOut)
        {
            await Live.UnwatchDirectoryAsync();
        }

        await Refresher.DisposeAsync();
    }
}
