@page "/sell"
@implements IAsyncDisposable
@inject AuctionApi Api
@inject Session Session
@inject IDialogService Dialogs
@inject LiveUpdates Live
@inject ViewRefresher Refresher

<PageTitle>Sell</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Sell</MudText>

@* A session can also end while the page is open: the first refused request signs it out. *@
@if (_signedOut || Session.Account is null)
{
    <PageState State="ViewState.Forbidden" ForbiddenText="Sign in to sell." SignInReturn="/sell" />
}
else if (Session.Account?.IsAdmin == true)
{
    <MudAlert Severity="Severity.Info">Admin accounts can't sell or bid.</MudAlert>
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="sell/new" Class="mb-4">New listing</MudButton>

    @if (_message is not null)
    {
        <MudAlert Class="mb-2" Severity="@(_failed ? Severity.Error : Severity.Success)" data-testid="sell-result"><MessageText Text="@_message" /></MudAlert>
    }

    @if (_list.Items is null)
    {
        <PageState State="ViewState.Loading" LoadingText="Loading your listings…" />
    }
    else if (_list.Items.Count == 0)
    {
        <div class="empty">
            <p class="empty-title">Nothing listed yet</p>
            <p class="muted">A listing starts as a private draft. Add photos, set the price and timing, then publish it. You can keep up to 10 drafts and publish 20 listings a day.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
    <MudSimpleTable Dense="true">
            <thead><tr><th>Item</th><th class="num">Price</th><th class="num">Bids</th><th>Status</th><th>Time</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var auction in _list.Items)
                {
                    <tr data-testid="my-auction-row">
                        <td>
                            <div class="row-item">
                                <Thumb Auction="auction" />
                                <MudLink Href="@($"auctions/{auction.Id}")">@auction.Title</MudLink>
                            </div>
                        </td>
                        <td class="num">@Format.Price(auction)</td>
                        <td class="num">@auction.BidCount</td>
                        <td><span class="@($"tag {Format.StatusTone(auction.Status)}")">@Format.Status(auction.Status)</span>@(Format.Outcome(auction) is { } outcome ? $" {outcome}" : "")</td>
                        <td><LotClock Auction="auction" /><div class="muted sub num">@Format.Time(auction.EndsAt)</div></td>
                        <td>
                            @if (auction.Status == "draft")
                            {
                                <MudButton Size="Size.Small" Href="@($"sell/{auction.Id}/edit")">Edit</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Primary" OnClick="() => PublishAsync(auction)" Disabled="_busy">Publish</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(auction)" Disabled="_busy">Delete</MudButton>
                            }
                            else if (auction.BidCount == 0 && auction.Status is "active" or "scheduled")
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => CancelAsync(auction)" Disabled="_busy">Cancel listing</MudButton>
                            }
                            else if (auction.Status is "active" or "scheduled")
                            {
                                <span class="muted sub">Has bids, so it can't be cancelled</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        </div>
        @if (_list.NextCursor is not null)
        {
            <MudButton Class="mt-2" Variant="Variant.Outlined" OnClick="_list.MoreAsync">Show more</MudButton>
        }
    }
}

@code {
    private LiveList<AuctionSummary> _list = null!;
    private string? _message;
    private bool _failed;
    private bool _signedOut;
    private bool _busy;

    // One key per action on each auction, kept until it succeeds, so a retry never repeats it.
    private readonly Dictionary<(Guid, string), string> _keys = [];

    protected override async Task OnInitializedAsync()
    {
        _list = new LiveList<AuctionSummary>(Api.MineAsync);
        await Session.LoadAsync();
        _signedOut = Session.Account is null;
        if (_signedOut)
        {
            return;
        }

        Live.Changed += OnChangedAsync;
        await _list.MoreAsync();
        if (_list.Error is not null)
        {
            (_failed, _message) = (true, _list.Error);
        }

        await Live.WatchDirectoryAsync();
        await Refresher.StartAsync(RefreshAsync);
    }

    private Task OnChangedAsync(AuctionChanged hint) =>
        _list.Items?.Find(item => item.Id == hint.AuctionId) is { } shown && hint.Version > shown.Version ? RefreshAsync() : Task.CompletedTask;

    private async Task RefreshAsync()
    {
        await _list.ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Live.Changed -= OnChangedAsync;
        if (!_signedOut)
        {
            await Live.UnwatchDirectoryAsync();
        }

        await Refresher.DisposeAsync();
    }

    // Each of these can't be taken back, so it names the listing and asks first.
    private async Task PublishAsync(AuctionSummary auction)
    {
        if (await ConfirmAsync($"Publish \"{auction.Title}\"?", "Bidders will see it and can bid. Its terms and photos can't be changed once it's published, and it can only be cancelled before the first bid.", "Publish listing", "Keep as draft"))
        {
            await RunAsync(auction.Id, "publish", key => Api.PublishAsync(auction.Id, key), $"Published \"{auction.Title}\".");
        }
    }

    private async Task DeleteAsync(AuctionSummary auction)
    {
        if (await ConfirmAsync($"Delete the draft \"{auction.Title}\"?", "The draft and its photos are removed. This can't be undone.", "Delete draft", "Keep draft"))
        {
            await RunAsync(auction.Id, "delete", key => Api.DeleteDraftAsync(auction.Id, key), $"Deleted the draft \"{auction.Title}\".");
        }
    }

    private async Task CancelAsync(AuctionSummary auction)
    {
        if (await ConfirmAsync($"Cancel \"{auction.Title}\"?", "It stops taking bids and can't be reopened. A listing can only be cancelled before its first bid.", "Cancel listing", "Keep listing"))
        {
            await RunAsync(auction.Id, "cancel", key => Api.CancelAsync(auction.Id, key), $"Cancelled \"{auction.Title}\".");
        }
    }

    private async Task<bool> ConfirmAsync(string title, string message, string yes, string no) =>
        await Dialogs.ShowMessageBoxAsync(title, message, yesText: yes, cancelText: no) is true;

    private async Task RunAsync(Guid id, string action, Func<string, Task<ApiResult<CommandResponse>>> call, string done)
    {
        if (!_keys.TryGetValue((id, action), out var key))
        {
            key = Guid.NewGuid().ToString();
            _keys[(id, action)] = key;
        }

        _busy = true;
        var result = await call(key);
        _busy = false;
        if (result.Succeeded || result.Problem!.Status is not (0 or 503))
        {
            _keys.Remove((id, action));
        }

        (_failed, _message) = result.Succeeded ? (false, done) : (true, result.Message);
        await _list.ReloadAsync();
    }
}
