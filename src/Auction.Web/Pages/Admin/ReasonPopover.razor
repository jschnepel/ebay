@* An admin action that needs a reason, asked for right beside its button: the reason goes with the action into the event log. *@
<span class="reason-anchor">
    <MudButton Size="Size.Small" Variant="@TriggerVariant" Color="@Tone" OnClick="Open" Disabled="Disabled">@Action</MudButton>
    <MudOverlay Visible="_open" OnClick="Close" AutoClose="true" />
    <MudPopover Open="_open" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="reason-popover-shell">
        <div class="reason-popover" role="dialog" aria-labelledby="@_titleId" @onkeydown="KeyAsync">
            <p id="@_titleId" class="reason-title">@Title</p>
            <MudTextField @bind-Value="_reason" Label="Reason" AutoFocus="true" Immediate="true" MaxLength="500"
                          Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@Helper" />
            <div class="reason-actions">
                <MudButton Variant="Variant.Text" OnClick="Close">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="@Tone" Disabled="@(string.IsNullOrWhiteSpace(_reason))" OnClick="ConfirmAsync">@Action</MudButton>
            </div>
        </div>
    </MudPopover>
</span>

@code {
    private readonly string _titleId = $"reason-{Guid.NewGuid():N}";
    private bool _open;
    private string _reason = "";

    /// <summary>The question at the top, such as "Disable Ada Lovelace?".</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>The verb on both buttons, such as "Disable".</summary>
    [Parameter, EditorRequired]
    public string Action { get; set; } = "";

    [Parameter]
    public string Helper { get; set; } = "Kept in the event log.";

    /// <summary>Red for actions that take something away, the brand colour for ones that give it back.</summary>
    [Parameter]
    public Color Tone { get; set; } = Color.Primary;

    [Parameter]
    public Variant TriggerVariant { get; set; } = Variant.Text;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string> OnConfirm { get; set; }

    private void Open() => (_open, _reason) = (true, "");

    private void Close() => _open = false;

    private async Task KeyAsync(KeyboardEventArgs key)
    {
        if (key.Key == "Escape")
        {
            Close();
        }
        else if (key.Key == "Enter" && !string.IsNullOrWhiteSpace(_reason))
        {
            await ConfirmAsync();
        }
    }

    private async Task ConfirmAsync()
    {
        var reason = _reason.Trim();
        _open = false;
        await OnConfirm.InvokeAsync(reason);
    }
}
