@page "/admin/users"
@inject AuctionApi Api
@inject Session Session

<PageTitle>Users</PageTitle>
<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Users</MudText>

@if (_forbidden)
{
    <PageState State="ViewState.Forbidden" ForbiddenText="Page not found." />
}
else
{
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.End" Class="mb-2">
        <MudTextField @bind-Value="_query" Label="Display name or account id" Immediate="true" />
        <MudButton Variant="Variant.Outlined" OnClick="SearchAsync">Search</MudButton>
    </MudStack>
    <MudTextField @bind-Value="_reason" Label="Reason (kept in the audit log)" Immediate="true" MaxLength="500" Class="mb-2" />

    @if (_message is not null)
    {
        <MudAlert Class="mb-2" Severity="@(_failed ? Severity.Error : Severity.Success)" data-testid="user-result">@_message</MudAlert>
    }

    @if (_items is not null)
    {
        <div class="table-scroll"><MudSimpleTable Dense="true">
            <thead><tr><th>Name</th><th>Kind</th><th>Account id</th><th>State</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var user in _items)
                {
                    <tr data-testid="user-row">
                        <td>@user.DisplayName</td>
                        <td>@user.Kind.Replace('_', ' ')</td>
                        <td><code>@user.Id</code></td>
                        <td>@(user.Disabled ? "Disabled" : "Enabled")</td>
                        <td>
                            @if (user.Id != Session.Account?.Id)
                            {
                                <MudButton Size="Size.Small" Color="@(user.Disabled ? Color.Primary : Color.Error)" OnClick="() => ToggleAsync(user)" Disabled="_busy">
                                    @(user.Disabled ? "Enable" : "Disable")
                                </MudButton>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable></div>
        @if (_next is not null)
        {
            <MudButton Class="mt-2" Variant="Variant.Outlined" OnClick="MoreAsync">Show more</MudButton>
        }
    }
}

@code {
    private string _query = "";
    private string _reason = "";
    private List<UserSummary>? _items;
    private string? _next;
    private string? _message;
    private bool _failed;
    private bool _busy;
    private bool _forbidden;

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        _forbidden = Session.Account?.IsAdmin != true;
        if (!_forbidden)
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        (_items, _next) = (null, null);
        await MoreAsync();
    }

    private async Task MoreAsync()
    {
        var page = await Api.AdminUsersAsync(_query, _next);
        if (!page.Succeeded)
        {
            (_failed, _message) = (true, page.Message);
            return;
        }

        (_items ??= []).AddRange(page.Value!.Items);
        _next = page.Value.NextCursor;
    }

    private async Task ToggleAsync(UserSummary user)
    {
        if (string.IsNullOrWhiteSpace(_reason))
        {
            (_failed, _message) = (true, "Give a reason first; it goes in the audit log.");
            return;
        }

        _busy = true;
        var result = await Api.SetUserDisabledAsync(user.Id, !user.Disabled, _reason);
        _busy = false;
        var done = user.Disabled ? "Enabled" : "Disabled";
        (_failed, _message) = result.Succeeded ? (false, $"{done} {user.DisplayName}.") : (true, result.Message);
        await SearchAsync();
    }
}
