@page "/admin/auctions"
@inject AuctionApi Api
@inject Session Session

<PageTitle>Moderate auctions</PageTitle>
<div class="page-head">
    <MudText Typo="Typo.h4" HtmlTag="h1">Auctions</MudText>
</div>

@if (_forbidden)
{
    <PageState State="ViewState.Forbidden" ForbiddenText="Page not found." />
}
else
{
    <div class="searchbar" role="search">
        <MudTextField @bind-Value="_query" Label="Title, seller name or id" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" OnKeyDown="SearchOnEnterAsync" />
        <MudSelect T="string" @bind-Value="_status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="string" Value="@("")">Any</MudSelectItem>
            <MudSelectItem T="string" Value="@("active")">Active</MudSelectItem>
            <MudSelectItem T="string" Value="@("scheduled")">Scheduled</MudSelectItem>
            <MudSelectItem T="string" Value="@("suspended")">Suspended</MudSelectItem>
            <MudSelectItem T="string" Value="@("closed")">Closed</MudSelectItem>
            <MudSelectItem T="string" Value="@("cancelled")">Cancelled</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">Search</MudButton>
    </div>

    @if (_message is not null)
    {
        <MudAlert Class="mb-3" Severity="@(_failed ? Severity.Error : Severity.Success)" data-testid="moderation-result"><MessageText Text="@_message" /></MudAlert>
    }

    @if (_items is null)
    {
        <PageState State="ViewState.Loading" LoadingText="Loading auctions…" />
    }
    else if (_items.Count == 0 && !_loadFailed)
    {
        <div class="empty"><p class="empty-title">No auctions match</p><p class="muted">Try another title, seller or status.</p></div>
    }
    else
    {
        <div class="panel table-panel table-scroll is-wide"><MudSimpleTable Dense="true" Elevation="0">
            <thead><tr><th>Item</th><th class="num">Price</th><th class="num">Bids</th><th>Status</th><th>Time</th><th><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var auction in _items)
                {
                    <tr data-testid="moderated-auction">
                        <td>
                            <MudLink Href="@($"auctions/{auction.Id}")" Class="cell-title">@auction.Title</MudLink>
                            <div class="muted cell-sub">by <a href="@($"admin/users/{auction.SellerId}")">@auction.SellerName</a></div>
                        </td>
                        <td class="num">@(auction.CurrentPriceCents is { } cents ? Format.Dollars(cents) : "no bids")</td>
                        <td class="num">@auction.BidCount</td>
                        <td><span class="@($"tag {Format.StatusTone(auction.Status)}")">@Format.Status(auction.Status)</span></td>
                        <td class="nowrap">@Format.Time(auction.EndsAt)</td>
                        <td class="actions">
                            @if (auction.Status == "active")
                            {
                                <ReasonPopover Title="@($"Suspend \"{auction.Title}\"?")" Action="Suspend" TriggerVariant="Variant.Outlined" Disabled="_busy"
                                               Helper="Bidding stops until it's resumed; the end time doesn't move. The seller and bidders are sent the reason."
                                               OnConfirm="reason => ModerateAsync(auction, Suspend, reason)" />
                            }
                            @if (auction.Status == "suspended")
                            {
                                <ReasonPopover Title="@($"Resume \"{auction.Title}\"?")" Action="Resume" TriggerVariant="Variant.Outlined" Disabled="_busy"
                                               Helper="Bidding reopens until its original end time. The seller and bidders are sent the reason."
                                               OnConfirm="reason => ModerateAsync(auction, Resume, reason)" />
                            }
                            @if (auction.Status is "scheduled" or "active" or "suspended")
                            {
                                <ReasonPopover Title="@($"Cancel \"{auction.Title}\"?")" Action="Cancel auction" Tone="Color.Error" Disabled="_busy"
                                               Helper="It ends with no sale and can't be reopened; its bids stay on record. The seller and bidders are sent the reason."
                                               OnConfirm="reason => ModerateAsync(auction, Cancel, reason)" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable></div>
        @if (_next is not null)
        {
            <MudButton Class="mt-3" Variant="Variant.Outlined" OnClick="MoreAsync">Show more</MudButton>
        }
    }
}

@code {
    private string _query = "";
    private string _status = "";
    private List<ModeratedAuction>? _items;
    private string? _next;
    private string? _message;
    private bool _failed;
    private bool _busy;
    private bool _forbidden;
    private bool _loadFailed;
    private readonly Dictionary<(Guid, string), string> _keys = [];
    private const string Suspend = "suspend";
    private const string Resume = "resume";
    private const string Cancel = "cancel";

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        _forbidden = Session.Account?.IsAdmin != true;
        if (!_forbidden)
        {
            await SearchAsync();
        }
    }

    private Task SearchOnEnterAsync(KeyboardEventArgs key) => key.Key == "Enter" ? SearchAsync() : Task.CompletedTask;

    private async Task SearchAsync()
    {
        (_items, _next, _loadFailed) = (null, null, false);
        await MoreAsync();
    }

    private async Task MoreAsync()
    {
        var page = await Api.AdminAuctionsAsync(_query, _status, _next);
        if (!page.Succeeded)
        {
            (_failed, _message) = (true, page.Message);
            _items ??= [];
            _loadFailed = true;
            return;
        }

        (_items ??= []).AddRange(page.Value!.Items);
        _next = page.Value.NextCursor;
    }

    private static string Done(string action) => action switch
    {
        Suspend => "Suspended",
        Resume => "Resumed",
        _ => "Cancelled",
    };

    private async Task ModerateAsync(ModeratedAuction auction, string action, string reason)
    {
        if (!_keys.TryGetValue((auction.Id, action), out var key))
        {
            key = Guid.NewGuid().ToString();
            _keys[(auction.Id, action)] = key;
        }

        _busy = true;
        var result = await Api.ModerateAsync(auction.Id, action, reason, key);
        _busy = false;
        if (result.Succeeded || result.Problem!.Status is not (0 or 503))
        {
            _keys.Remove((auction.Id, action));
        }

        (_failed, _message) = result.Succeeded ? (false, $"{Done(action)} \"{auction.Title}\".") : (true, result.Message);
        await SearchAsync();
    }
}
