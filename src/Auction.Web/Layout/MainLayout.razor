@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject Notices Notices
@inject LiveUpdates Live
@inject NavigationManager Navigation

<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="appbar">
        <a href="./" class="brand d-none d-sm-inline">Auctions</a>
        <nav aria-label="Main" class="nav">
            @if (Session.Account?.IsAdmin == true)
            {
                @* Admin accounts can't buy or sell, so they see only the admin area. *@
                <NavLink href="admin" Match="NavLinkMatch.All">Activity</NavLink>
                <NavLink href="admin/auctions">Auctions</NavLink>
                <NavLink href="admin/users">Users</NavLink>
                <NavLink href="admin/audit">Audit log</NavLink>
            }
            else
            {
                <NavLink href="./" Match="NavLinkMatch.All">Buy</NavLink>
                <NavLink href="my-bids">My bids</NavLink>
                <NavLink href="sell">Sell</NavLink>
            }
        </nav>
        <MudSpacer />
        @if (Session.Account is { } account)
        {
            <MudBadge Content="@Notices.Unread" Visible="@(Notices.Unread > 0)" Color="Color.Error" Overlap="true" Class="mr-2">
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Href="notifications"
                               aria-label="@($"Notifications, {Notices.Unread} unread")" data-testid="bell" />
            </MudBadge>
            <span hidden data-testid="unread-count">@Notices.Unread</span>
            <MudText Class="mr-2 d-none d-sm-flex" data-testid="signed-in-as">@account.DisplayName</MudText>
            <MudButton Color="Color.Inherit" OnClick="SignOutAsync">Sign out</MudButton>
        }
        else
        {
            <MudButton Href="sign-in" Color="Color.Inherit">Sign in</MudButton>
        }
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
            @if (Session.EndedElsewhere)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4" data-testid="signed-out-notice">
                    Signed out: your account signed in elsewhere. <MudLink Href="sign-in">Sign in again</MudLink> to continue here.
                </MudAlert>
            }
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    // Petrol ink on cool paper, matching the tokens in app.css; text meets WCAG AA on the bar and the page.
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#12343B",
            AppbarBackground = "#12343B",
            Background = "#F3F5F4",
            Surface = "#FFFFFF",
            Secondary = "#7A5410",
            Success = "#2E6B45",
            Error = "#A3261E",
            TextPrimary = "#12343B",
            TextSecondary = "#5B676A",
            LinesDefault = "#D3DCDA",
            TableLines = "#D3DCDA",
            Divider = "#D3DCDA",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "sans-serif"] },
            Button = new ButtonTypography { TextTransform = "none", FontWeight = "600" },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" },
    };

    private Guid? _connectedAs;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Notices.Changed += OnNoticesChanged;
        Live.Notified += Notices.RefreshAsync;
        Live.Reconnected += RefreshNoticesAsync;
        Live.SignedOut += OnSignedOutAsync;
        await Session.LoadAsync();
        await FollowSessionAsync();
    }

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("./");
    }

    // The live connection belongs to whoever is signed in; it's reopened when that changes.
    private async Task FollowSessionAsync()
    {
        var current = Session.Account?.Id;
        if (current == _connectedAs)
        {
            return;
        }

        _connectedAs = current;
        if (current is null)
        {
            Notices.Clear();
            await Live.RestartAsync();
            return;
        }

        await Live.RestartAsync();
        await Notices.RefreshAsync();
    }

    private Task RefreshNoticesAsync() => Session.Account is null ? Task.CompletedTask : Notices.RefreshAsync();

    private Task OnSignedOutAsync()
    {
        Session.SignedOutElsewhere();
        return Task.CompletedTask;
    }

    private void OnSessionChanged() => InvokeAsync(async () =>
    {
        StateHasChanged();
        await FollowSessionAsync();
    });

    private void OnNoticesChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Notices.Changed -= OnNoticesChanged;
        Live.Notified -= Notices.RefreshAsync;
        Live.Reconnected -= RefreshNoticesAsync;
        Live.SignedOut -= OnSignedOutAsync;
    }
}
