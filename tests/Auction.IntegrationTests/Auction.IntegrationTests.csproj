<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Deque.AxeCore.Playwright" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.HealthCheck" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Auction.Migrator\Auction.Migrator.csproj" />
    <ProjectReference Include="..\..\src\Auction.Engine\Auction.Engine.csproj" />
    <ProjectReference Include="..\..\src\Auction.Api\Auction.Api.csproj" />
    <ProjectReference Include="..\..\src\Auction.Simulator\Auction.Simulator.csproj" />
    <ProjectReference Include="..\Auction.ReferenceModel\Auction.ReferenceModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same bootstrap script Compose runs, so the tests exercise the real roles. -->
    <None Include="..\..\deploy\postgres\init-roles.sh" Link="init-roles.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- A client generated from the same contract the engine serves. -->
    <Protobuf Include="..\..\src\Auction.Contracts\auction\v1\auction.proto" ProtoRoot="..\..\src\Auction.Contracts" GrpcServices="Client" Link="Protos\auction.proto" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
